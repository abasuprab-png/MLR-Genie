# Sanitized environment variable names referenced by backend/config.py and deploy/terraform/main.tf
# Leave GEMINI_API_KEY unset to run in 100% offline/deterministic fallback mode with zero paid model calls.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_API_KEY=
GCP_CMEK_KEY_NAME=
GCP_MODEL_ARMOR_TEMPLATE=
MLR_GCS_BUCKET=
DATABASE_URL=
# Hosted is the default when unset. Explicit local is for deliberate development only.
# Cloud Run refuses local mode whenever K_SERVICE is set.
MLR_GENIE_ENV=hosted
# With ENV unset, local opt-in also requires the launcher's actual loopback bind:
# MLR_GENIE_ALLOW_LOCAL=true python -m backend.server --host 127.0.0.1 --port 8000
MLR_GENIE_ALLOW_LOCAL=false
# Hosted defaults to no browser origins. Comma-separated exact HTTP(S) origins only.
MLR_GENIE_ALLOWED_ORIGINS=
# Hosted always requires signed bearer tokens; local can opt into that rule too.
MLR_REQUIRE_SIGNED_BEARER_TOKEN=true
# Hosted startup requires a private secret of at least 32 UTF-8 bytes; never commit it.
MLR_GENIE_SESSION_SECRET=
# Hosted issuance requires this secret and a matching X-MLR-Bootstrap-Secret header.
MLR_GENIE_BOOTSTRAP_SECRET=
# Hosted token lifetime cap: integer 1..86400. Requests default to 3600 seconds.
# A cap below 3600 requires an explicit shorter ttl_seconds in token requests.
MLR_GENIE_MAX_TOKEN_TTL_SECONDS=3600
# Rotating MLR_GENIE_SESSION_SECRET revokes every outstanding signed token.

# Fail assessment endpoints explicitly if live Gemini is unavailable.
# Live assessments are already required whenever a provider/client is configured.
MLR_REQUIRE_LIVE_GEMINI=false
VEEVA_OAUTH_SECRET=
APRIMO_OAUTH_SECRET=
