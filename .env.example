# Sanitized environment variable names referenced by backend/config.py and deploy/terraform/main.tf
# Leave GEMINI_API_KEY unset to run in 100% offline/deterministic fallback mode with zero paid model calls.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_API_KEY=
GCP_CMEK_KEY_NAME=
GCP_MODEL_ARMOR_TEMPLATE=
MLR_GCS_BUCKET=
DATABASE_URL=
# Job routes can require signed Authorization: Bearer tokens (default: legacy headers allowed).
MLR_REQUIRE_SIGNED_BEARER_TOKEN=false
# Configure securely for shared environments; never commit a signing secret.
MLR_GENIE_SESSION_SECRET=
# When configured, /auth/token requires a matching X-MLR-Bootstrap-Secret header.
MLR_GENIE_BOOTSTRAP_SECRET=
VEEVA_OAUTH_SECRET=
APRIMO_OAUTH_SECRET=
